{
  "name": "dsh-controller",
  "version": "0.1.0",
  "private": true,
  "description": "DeepSeek Harness 插件：让 agent 控制 DSH 自身。先走 DSH 自己暴露的 API（cordis 服务），走不通再退回桌面自动化。",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./index.mjs",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "index.mjs",
    "src",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test \"tests/*.test.mjs\"",
    "check": "node --check index.mjs",
    "selftest": "node selftest.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
